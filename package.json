{
  "name": "dsh-market-sync",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "每天 00:00 把 GitHub 上以 DSH 开头的插件补上 dsh-plugin topic，并在市场漏扫时自动提 submission issue，让 dsh.market 自动收录。",
  "main": "src/plugin.js",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xkzdwb/DSH-MarketSync-WhenNewPlugin.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-market",
    "cordis",
    "automation"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/run-tests.mjs",
    "authorize": "node tools/authorize.mjs",
    "sync": "node tools/sync-once.mjs",
    "sync:dry": "node tools/sync-once.mjs --dry-run"
  }
}
